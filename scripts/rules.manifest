# rules.manifest: the version-bound fixes (grade C = tied to a macOS/Rosetta build, grade D = tied to a game build).
# Read by run-aoe2.sh for names and warnings. Each fix finds its own sites by fingerprint and switches itself off on
# any other version; the launcher then says so. Format: rule <id> key=value ... (quote values with spaces).
# pack = version of this rule set; a later update channel can replace this file (and pattern files it names)
# without a new download of the binaries. See docs/rule-updates.md.
pack 2026.11.22-1 format=1
rule reorder grade=D target=game name="Health-bar speed-up" off=AOE2_NO_REORDER status=mk_reorder pattern=builtin:mk_reorder.py
rule f54a grade=C target=rosetta name="Stutter fix" off=AOE2_NO_F54A status=log:reclaimcap pattern=builtin:x87sidecar
rule t13 grade=D target=game name="Faster return checks" off=AOE2_NO_T13 status=mk_rules pattern=builtin:mk_rules.py
