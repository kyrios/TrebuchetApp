@@ -2610,12 +2645,61 @@ static void check_command_line( int argc, char *argv[] )
  *
  * Main entry point called by the wine loader.
  */
+#if defined(__APPLE__) && defined(__x86_64__)
+/* AoE2 soft-fault delivery (ported from the AoE IV Rosetta patch by Marc Ibrahim /
+ * NerRobDog, LGPL). The game's anti-tamper raises invalid-opcode exceptions as control
+ * flow. With AOE2_SOFTFAULT=1 the x87sidecar makes Rosetta lower those opcodes inside the
+ * game's .text into a call to __wine_aoe_softfault*, which raises the very same
+ * EXCEPTION_ILLEGAL_INSTRUCTION through NtRaiseException without a kernel trap and
+ * without Rosetta's exception server. Game bytes are never modified. */
+static const char *aoe_exe_name(char **argv)
+{
+    const char *name=argv[1],*slash;
+    if ((slash=strrchr(name,'/'))) name=slash+1;
+    if ((slash=strrchr(name,'\\'))) name=slash+1;
+    return name;
+}
+
+static void aoe_exec_sidecar(const char *sidecar, const char *loader, int argc, char **argv)
+{
+    char **args;
+    unsigned int i;
+    args=calloc(argc+3,sizeof(*args));
+    if (!args) fatal_error("cannot allocate software fault launch arguments\n");
+    args[0]=(char *)sidecar;args[1]="--cooperative";args[2]=(char *)loader;
+    for(i=1;i<argc;i++)args[i+2]=argv[i];
+    unsetenv("WINELOADERNOEXEC");
+    execv(sidecar,args);
+    fatal_error("cannot launch software fault translator: %s\n",strerror(errno));
+}
+
+static void aoe_reexec_sidecar(int argc, char **argv)
+{
+    const char *sidecar=getenv("AOELAB_SIDECAR_PATH"),*loader=getenv("WINELOADER");
+    if (!sidecar || sidecar[0]!='/' || !loader || argc<2 || getenv("X87_SIDECAR_BOOTSTRAP")) return;
+    if (getenv("AOE2_SOFTFAULT") && !strcasecmp(aoe_exe_name(argv),"AoE2DE_s.exe"))
+    {
+        /* .text of AoE2DE_s.exe 101.103.57257.0 (sha256 1e415af8...); overridable. */
+        setenv("AOELAB_SOFTFAULT_BRIDGE","1",1);
+        if (!getenv("AOE_SOFTFAULT_PC")) setenv("AOE_SOFTFAULT_PC","0x140001000",1);
+        if (!getenv("AOE_SOFTFAULT_END")) setenv("AOE_SOFTFAULT_END","0x143195ef2",1);
+        setenv("AOE_SOFTFAULT_TARGET1","0x180000000",1);
+        setenv("AOE_SOFTFAULT_TARGET","0x180000010",1);
+        setenv("X87_ALWAYS_NONE","1",1);
+        aoe_exec_sidecar(sidecar,loader,argc,argv);
+    }
+}
+#endif
+
 DECLSPEC_EXPORT void __wine_main( int argc, char *argv[] )
 {
     main_argc = argc;
     main_argv = argv;
 
     init_paths();
+#if defined(__APPLE__) && defined(__x86_64__)
+    aoe_reexec_sidecar(argc,argv);
+#endif
     if (!getenv( "WINELOADERNOEXEC" ) || argc <= 1) check_command_line( argc, argv );
     unsetenv( "WINELOADERNOEXEC" );
 
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 91926a8..7891665 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -1215,6 +1215,21 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
  *              NtGetContextThread  (NTDLL.@)
  *              ZwGetContextThread  (NTDLL.@)
  */
+/* Private software-exception context supplement. Use the same per-thread
+ * debug register cache as save_context(), avoiding a server round trip. */
+NTSTATUS aoe_exception_context(void *args)
+{
+    CONTEXT *context = args;
+    struct amd64_thread_data *data = amd64_thread_data();
+    context->SegCs = cs64_sel;
+    context->SegSs = context->SegDs = context->SegEs = context->SegGs = ds64_sel;
+    context->SegFs = data->fs;
+    context->Dr0 = data->dr0; context->Dr1 = data->dr1;
+    context->Dr2 = data->dr2; context->Dr3 = data->dr3;
+    context->Dr6 = data->dr6; context->Dr7 = data->dr7;
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS WINAPI NtGetContextThread( HANDLE handle, CONTEXT *context )
 {
     struct syscall_frame *frame = get_syscall_frame();
