index 6bc8f32..4d02252 100644
--- a/src/dxmt/meson.build
+++ b/src/dxmt/meson.build
@@ -22,7 +22,7 @@ dxmt_shaders = [
   'dxmt_command.metal'
 ]
 
-dxmt_shaders_ir = metalir_generator.process(dxmt_shaders)
+dxmt_shaders_ir = metalir_generator.process(dxmt_shaders, extra_args: ['-std=metal3.1', '--target=air64-apple-macos14.0'])
 
 dxmt_shaders_lib = metallib_generator.process(dxmt_shaders_ir)
 
