From 451ff20633fc48bae02771ae264e6bda33cae187 Mon Sep 17 00:00:00 2001
From: dxmt-label <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 00:15:34 +0100
Subject: [PATCH 2/3] feat(d3d11): SwapDeviceContextState (Wine d2d1 on D3D11,
 CaptureAge R2)

Wine's d2d1 swaps its own ID3DDeviceContextState in around every Direct2D draw.
The live D3D11 state now moves into the active state object and the target
object's state moves into the context; encoder bindings are rebuilt as in
ExecuteCommandList(RestoreContextState=TRUE). AoE2 never calls it:
initpitch 8/8, exediff 204/204, textpass 16/16, samptest 24/24 byte-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d11/d3d11_context_impl.cpp  | 44 ++++++++++++++++++++++++++++++-
 src/d3d11/d3d11_context_state.hpp |  4 +++
 2 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/src/d3d11/d3d11_context_impl.cpp b/src/d3d11/d3d11_context_impl.cpp
index 4b43cb2..fce9472 100644
--- a/src/d3d11/d3d11_context_impl.cpp
+++ b/src/d3d11/d3d11_context_impl.cpp
@@ -1819,7 +1819,46 @@ public:
   void
   STDMETHODCALLTYPE
   SwapDeviceContextState(ID3DDeviceContextState *pState, ID3DDeviceContextState **ppPreviousState) override {
-    IMPLEMENT_ME
+    // capsurf R2: Wine's d2d1 swaps its own state in around every Direct2D draw and swaps the
+    // previous one back afterwards. The current D3D11 state moves into the active state object
+    // (created on first use), the target object's state moves into the context, and the encoder
+    // bindings are rebuilt the same way ExecuteCommandList(RestoreContextState=TRUE) does.
+    if (ppPreviousState)
+      *ppPreviousState = nullptr;
+    if (!pState)
+      return;
+    std::lock_guard<mutex_t> lock(mutex);
+
+    auto next = static_cast<MTLD3D11DeviceContextState *>(pState);
+    if (!active_context_state_)
+      active_context_state_ = new MTLD3D11DeviceContextState(device);
+    Com<MTLD3D11DeviceContextState, false> prev = active_context_state_;
+
+    if (ppPreviousState)
+      *ppPreviousState = ref(prev.ptr());
+    if (next == prev.ptr())
+      return;
+
+    ResetEncodingContextState();
+    prev->saved_state = std::move(state_);
+    state_ = std::move(next->saved_state);
+    next->saved_state = {};
+    active_context_state_ = next;
+
+    RestoreEncodingContextState();
+    for (auto &stage : state_.ShaderStages) {
+      stage.SRVs.set_dirty();
+      stage.Samplers.set_dirty();
+      stage.ConstantBuffers.set_dirty();
+    }
+    state_.ComputeStageUAV.UAVs.set_dirty();
+    state_.InputAssembler.VertexBuffers.set_dirty();
+    state_.OutputMerger.UAVs.set_dirty();
+    state_.StreamOutput.Targets.set_dirty();
+    dirty_state.set(
+        DirtyState::BlendFactorAndStencilRef, DirtyState::RasterizerState, DirtyState::DepthStencilState,
+        DirtyState::Viewport, DirtyState::Scissors
+    );
   }
 
   void
@@ -4829,6 +4868,9 @@ public:
 
   Flags<DirtyState> dirty_state = 0;
 
+  // capsurf R2: the ID3DDeviceContextState whose state is currently live (SwapDeviceContextState)
+  Com<MTLD3D11DeviceContextState, false> active_context_state_ = nullptr;
+
 #pragma endregion
 
 protected:
diff --git a/src/d3d11/d3d11_context_state.hpp b/src/d3d11/d3d11_context_state.hpp
index f5314b0..d24dfeb 100644
--- a/src/d3d11/d3d11_context_state.hpp
+++ b/src/d3d11/d3d11_context_state.hpp
@@ -190,6 +190,10 @@ public:
 
   ~MTLD3D11DeviceContextState() {}
 
+  // capsurf R2: the D3D11 state this object holds while it is not active
+  // (SwapDeviceContextState moves state in and out; used by Wine's d2d1)
+  D3D11ContextState saved_state = {};
+
   HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) {
     if (ppvObject == nullptr)
       return E_POINTER;
-- 
