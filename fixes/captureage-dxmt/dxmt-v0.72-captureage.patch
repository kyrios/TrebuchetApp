From 6a787ea124ba1f874ad776e203fbacc4270e69f6 Mon Sep 17 00:00:00 2001
From: dxmt-label <noreply@anthropic.com>
Date: Mon, 23 Nov 2026 12:18:39 +0100
Subject: [PATCH 1/3] feat(d3d11): IDXGISurface2 on Texture2D for
 CaptureAge.exe only (Direct2D on D3D11 textures)

CaptureAge's renderer calls backTexture.As(&IDXGISurface) and then ID2D1Factory::CreateDxgiSurfaceRenderTarget.
The surface object is created only when the process is CaptureAge.exe; every other process keeps
E_NOINTERFACE for IDXGISurface* (byte-identical outputs in initpitch/exediff/textpass/samptest).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d11/d3d11_resource.hpp       | 15 ++++++-
 src/d3d11/d3d11_texture_device.cpp | 10 +++++
 src/dxgi/dxgi_resource.hpp         | 68 ++++++++++++++++++++++++++++++
 3 files changed, 92 insertions(+), 1 deletion(-)

diff --git a/src/d3d11/d3d11_resource.hpp b/src/d3d11/d3d11_resource.hpp
index 27b62a4..e154aa8 100644
--- a/src/d3d11/d3d11_resource.hpp
+++ b/src/d3d11/d3d11_resource.hpp
@@ -169,7 +169,12 @@ public:
             device),
         desc(desc),
         dxgi_resource(new MTLDXGIResource<TResourceBase<tag, Base...>>(this)),
-        d3d10(reinterpret_cast<tag::COM *>(this), device->GetImmediateContextPrivate()) {}
+        d3d10(reinterpret_cast<tag::COM *>(this), device->GetImmediateContextPrivate()) {
+    if constexpr (tag::dimension == D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+      if (DXGISurfaceEnabledForProcess())
+        dxgi_surface.reset(new MTLDXGISurface<TResourceBase<tag, Base...>>(this));
+    }
+  }
 
   template <std::size_t n> HRESULT ResolveBase(REFIID riid, void **ppvObject) {
     return E_NOINTERFACE;
@@ -217,6 +222,13 @@ public:
       return S_OK;
     }
 
+    /* only set for 2D textures in CaptureAge.exe; elsewhere nullptr, so the query falls through as before */
+    if (dxgi_surface && (riid == __uuidof(IDXGISurface) || riid == __uuidof(IDXGISurface1) ||
+                         riid == __uuidof(IDXGISurface2))) {
+      *ppvObject = ref(dxgi_surface.get());
+      return S_OK;
+    }
+
     if (logQueryInterfaceError(__uuidof(typename tag::COM), riid)) {
       WARN("D3D11Resource(", tag::debug_name ,"): Unknown interface query ", str::format(riid));
     }
@@ -286,6 +298,7 @@ public:
 protected:
   tag::DESC1 desc;
   std::unique_ptr<IDXGIResource1> dxgi_resource;
+  std::unique_ptr<IDXGISurface2> dxgi_surface;
   tag::D3D10_IMPL d3d10;
 };
 
diff --git a/src/d3d11/d3d11_texture_device.cpp b/src/d3d11/d3d11_texture_device.cpp
index 1d7cc14..11a32cd 100644
--- a/src/d3d11/d3d11_texture_device.cpp
+++ b/src/d3d11/d3d11_texture_device.cpp
@@ -8,9 +8,19 @@
 #include "dxmt_texture.hpp"
 #include "d3d11_resource.hpp"
 #include "util_win32_compat.h"
+#include "util_env.hpp"
+#include <cstring>
 
 namespace dxmt {
 
+bool
+DXGISurfaceEnabledForProcess() {
+  // CaptureAge's renderer needs IDXGISurface on 2D textures (Direct2D on D3D11). Answered nowhere else.
+  static const bool enabled = strcasecmp(env::getExeName().c_str(), "CaptureAge.exe") == 0;
+  return enabled;
+}
+
+
 #pragma region DeviceTexture
 
 template <typename tag_texture>
diff --git a/src/dxgi/dxgi_resource.hpp b/src/dxgi/dxgi_resource.hpp
index 8ebfc09..12d4319 100644
--- a/src/dxgi/dxgi_resource.hpp
+++ b/src/dxgi/dxgi_resource.hpp
@@ -3,6 +3,7 @@
 /* header only: use it as an aggregated object */
 
 #include "dxgi1_2.h"
+#include "d3d11.h"
 #include "log/log.hpp"
 
 namespace dxmt {
@@ -110,4 +111,71 @@ private:
   IResource *resource_; // since it's aggregated, no extra reference is needed
 };
 
+/* IDXGISurface2 view of a 2D texture (aggregated, like MTLDXGIResource).
+ * Only created for CaptureAge.exe (see DXGISurfaceEnabledForProcess): its renderer draws with Direct2D onto D3D11
+ * textures via ID2D1Factory::CreateDxgiSurfaceRenderTarget, which needs this interface. Every other process keeps
+ * the old behaviour (QueryInterface(IDXGISurface*) -> E_NOINTERFACE). */
+template <DXGIResourceAggregateContext IResource> class MTLDXGISurface : public IDXGISurface2 {
+public:
+  MTLDXGISurface(IResource *pResource) : resource_(pResource) {}
+  virtual ~MTLDXGISurface() {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) final {
+    return resource_->QueryInterface(riid, ppvObject);
+  }
+  ULONG STDMETHODCALLTYPE AddRef() final { return resource_->AddRef(); }
+  ULONG STDMETHODCALLTYPE Release() final { return resource_->Release(); }
+
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID guid, UINT data_size, const void *data) final {
+    return resource_->SetPrivateData(guid, data_size, data);
+  }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID guid, const IUnknown *object) final {
+    return resource_->SetPrivateDataInterface(guid, object);
+  }
+  HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID guid, UINT *data_size, void *data) final {
+    return resource_->GetPrivateData(guid, data_size, data);
+  }
+  HRESULT STDMETHODCALLTYPE GetParent(REFIID riid, void **parent) final { return GetDevice(riid, parent); }
+  HRESULT STDMETHODCALLTYPE GetDevice(REFIID riid, void **ppDevice) final {
+    return resource_->GetDeviceInterface(riid, ppDevice);
+  }
+
+  HRESULT STDMETHODCALLTYPE GetDesc(DXGI_SURFACE_DESC *pDesc) final {
+    if (!pDesc)
+      return E_INVALIDARG;
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D *texture = nullptr;
+    if (FAILED(resource_->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void **>(&texture))))
+      return E_FAIL;
+    texture->GetDesc(&desc);
+    texture->Release();
+    pDesc->Width = desc.Width;
+    pDesc->Height = desc.Height;
+    pDesc->Format = desc.Format;
+    pDesc->SampleDesc = desc.SampleDesc;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE Map(DXGI_MAPPED_RECT *pLockedRect, UINT MapFlags) final {
+    ERR_ONCE("DXGISurface::Map: not supported");
+    return DXGI_ERROR_INVALID_CALL;
+  }
+  HRESULT STDMETHODCALLTYPE Unmap() final { return DXGI_ERROR_INVALID_CALL; }
+  HRESULT STDMETHODCALLTYPE GetDC(BOOL Discard, HDC *phdc) final {
+    ERR_ONCE("DXGISurface::GetDC: not supported");
+    return E_NOTIMPL;
+  }
+  HRESULT STDMETHODCALLTYPE ReleaseDC(RECT *pDirtyRect) final { return E_NOTIMPL; }
+  HRESULT STDMETHODCALLTYPE GetResource(REFIID riid, void **ppParentResource, UINT *pSubresourceIndex) final {
+    if (pSubresourceIndex)
+      *pSubresourceIndex = 0;
+    return resource_->QueryInterface(riid, ppParentResource);
+  }
+
+private:
+  IResource *resource_;
+};
+
+/* true only in CaptureAge.exe (decided once per process). */
+bool DXGISurfaceEnabledForProcess();
+
 } // namespace dxmt
\ No newline at end of file
